# Email delivery (form handler → Resend). Copy to .env.local and fill in.

# Required. Without it the form still succeeds but only logs the lead.
RESEND_API_KEY=

# Required. Must be a sender on a domain you have verified in Resend.
# Cannot be a plain Gmail/Outlook address.
LEAD_NOTIFICATION_FROM=offers@atlaseqg.com

# Optional. Defaults to `site.email` in lib/site.ts
# (currently agreements@atlaseqg.com). Set only to override.
LEAD_NOTIFICATION_TO=
